# ──────────────────────────────────────────────────────────────────────
# UACM — Unified Ad Campaign Manager
# Copy this file to `.env` and fill in the values for your environment.
# ──────────────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ad_manager?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:63790"

# ── RabbitMQ ──────────────────────────────────────────────────────────
RABBITMQ_URL="amqp://localhost:5672"

# ── JWT ───────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── SMTP (Email) ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (defaults to http://localhost:3000)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.com

# ── Frontend / Backend URLs ───────────────────────────────────────────
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Google OAuth (User Authentication) ────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:8030/api/v1/auth/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8030/api/v1/auth/oauth/google/callback

# ── Token Encryption ─────────────────────────────────────────────────
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="your_64_char_hex_encryption_key_here"
AD_ACCOUNT_DEFAULT_TENANT_ID=""

# ── Meta Ads (Facebook/Instagram) OAuth ───────────────────────────────
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
META_REDIRECT_URI="http://localhost:8030/api/v1/ad-accounts/oauth/callback"
META_API_VERSION="v21.0"
META_SCOPE="ads_management,ads_read,business_management"

# ── Google Ads OAuth ──────────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID="your_google_ads_client_id_here"
GOOGLE_ADS_CLIENT_SECRET="your_google_ads_client_secret_here"
GOOGLE_ADS_DEVELOPER_TOKEN="your_developer_token_here"
GOOGLE_ADS_REDIRECT_URI="http://localhost:8030/api/v1/ad-accounts/oauth/callback"
GOOGLE_ADS_SCOPE="https://www.googleapis.com/auth/adwords"
GOOGLE_ADS_LOGIN_CUSTOMER_ID="your_customer_id_here"

# ── LinkedIn Ads OAuth ────────────────────────────────────────────────
LINKEDIN_CLIENT_ID="your_linkedin_client_id_here"
LINKEDIN_CLIENT_SECRET="your_linkedin_client_secret_here"
LINKEDIN_REDIRECT_URI="http://localhost:8030/api/v1/ad-accounts/oauth/callback"
LINKEDIN_SCOPE="r_ads r_ads_reporting"

# ── X (Twitter) Ads OAuth ────────────────────────────────────────────
X_CLIENT_ID="your_x_client_id_here"
X_CLIENT_SECRET="your_x_client_secret_here"
X_REDIRECT_URI="http://localhost:8030/api/v1/ad-accounts/oauth/callback"
X_SCOPE="tweet.read users.read offline.access ads.read"

# ── Snapchat Ads OAuth ───────────────────────────────────────────────
SNAPCHAT_CLIENT_ID="your_snapchat_client_id_here"
SNAPCHAT_CLIENT_SECRET="your_snapchat_client_secret_here"
SNAPCHAT_REDIRECT_URI="http://localhost:8030/api/v1/ad-accounts/oauth/callback"
SNAPCHAT_SCOPE="snapchat-marketing-api"

# ── TikTok Ads OAuth ─────────────────────────────────────────────────
TIKTOK_APP_ID="your_tiktok_app_id_here"
TIKTOK_SECRET="your_tiktok_secret_here"
TIKTOK_REDIRECT_URI="http://localhost:8030/api/v1/ad-accounts/oauth/callback"
TIKTOK_SCOPE="ad.account.read,ad.campaign.read"
