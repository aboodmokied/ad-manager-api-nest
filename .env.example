NODE_ENV=development
# HTTP port the API listens on (defaults to 8030)
PORT=8030
DATABASE_URL="postgresql://admin:secret@localhost:5432/ad_manager?schema=public"
REDIS_URL="redis://localhost:63790"
RABBITMQ_URL="amqp://localhost:5672"
JWT_SECRET="change-me-to-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"
# Base URL of this backend - used to build email verification and password reset links
BACKEND_URL="http://localhost:8030"
MAIL_FROM="mohamedalnajjar1000@gmail.com"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
EMAIL_USER="mohamedalnajjar1000@gmail.com"
EMAIL_PASSWORD=""
# Google OAuth (login with Google). GOOGLE_REDIRECT_URI defaults to
# ${BACKEND_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Advertising account linking (Ad Accounts module - FR-10/FR-14)
# ---------------------------------------------------------------------------
# Key used to encrypt OAuth access/refresh tokens at rest (AES-256-GCM).
# 32 bytes as hex (64 chars) or base64 (44 chars), or any string (hashed).
# MUST be set when NODE_ENV=production - a development key is used otherwise.
TOKEN_ENCRYPTION_KEY=""
# Tenancy: when set, all linked accounts/imported campaigns belong to this
# tenant; otherwise each user acts as their own tenant.
AD_ACCOUNT_DEFAULT_TENANT_ID=""

# Meta Ads (Facebook/Instagram) OAuth - https://developers.facebook.com/apps
META_APP_ID=""
META_APP_SECRET=""
# Optional. Defaults to ${BACKEND_URL}/api/v1/ad-accounts/oauth/callback
META_REDIRECT_URI=""
META_API_VERSION="v21.0"
META_SCOPE="ads_management,ads_read,business_management"

# Google Ads OAuth - https://console.cloud.google.com + Google Ads developer token
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
# Optional. Defaults to ${BACKEND_URL}/api/v1/ad-accounts/oauth/callback
GOOGLE_ADS_REDIRECT_URI=""
GOOGLE_ADS_SCOPE="https://www.googleapis.com/auth/adwords"
# Optional. Set when making calls as a Manager account (login-customer-id header)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# LinkedIn Ads OAuth - https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Optional. Defaults to ${BACKEND_URL}/api/v1/ad-accounts/oauth/callback
LINKEDIN_REDIRECT_URI=""
LINKEDIN_SCOPE="r_ads,r_ads_reporting"

# X (Twitter) Ads OAuth - https://developer.x.com (PKCE is mandatory, offline.access is required for refresh tokens)
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# Optional. Defaults to ${BACKEND_URL}/api/v1/ad-accounts/oauth/callback
X_REDIRECT_URI=""
X_SCOPE="tweet.read users.read offline.access ads.read"

# Snapchat Ads OAuth - https://business.snapchat.com → Ads Manager → Business details
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
# Optional. Defaults to ${BACKEND_URL}/api/v1/ad-accounts/oauth/callback
SNAPCHAT_REDIRECT_URI=""
SNAPCHAT_SCOPE="snapchat-marketing-api"

# TikTok Ads OAuth - https://ads.tiktok.com/marketing_api/apps (app_id, not client_id)
TIKTOK_APP_ID=""
TIKTOK_SECRET=""
# Optional. Defaults to ${BACKEND_URL}/api/v1/ad-accounts/oauth/callback
TIKTOK_REDIRECT_URI=""
TIKTOK_SCOPE="ad.account.read,ad.campaign.read"
