{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "src/*": ["src/*"],
      "@/*": ["src/*"]
    },
    "isolatedModules": true,
    "esModuleInterop": false,
    "strictNullChecks": false,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "test/**/*"]
}
