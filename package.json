{
  "name": "uacm-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "pnpm --filter @uacm/web run test:e2e:ui",
    "test:e2e:codegen": "pnpm --filter @uacm/web run test:e2e:codegen",
    "test:e2e:report": "pnpm --filter @uacm/web run test:e2e:report",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @uacm/database run db:generate",
    "db:push": "pnpm --filter @uacm/database run db:push",
    "db:migrate": "pnpm --filter @uacm/database run db:migrate",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.10",
    "typescript": "^5.6.3"
  }
}
