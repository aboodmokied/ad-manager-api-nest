// Prisma schema for the Unified Ad Campaign Manager (UACM)
// This schema defines all models for the backend application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model representing a registered user of the platform
model User {
  id               String   @id @default(cuid())
  name             String   // User's display name
  email            String   @unique // Login email (unique - one account per email)
  passwordHash     String   // Password stored as a bcrypt hash (never plaintext)
  twoFactorEnabled Boolean  @default(false) // Whether 2FA (TOTP) is enabled for this account
  twoFactorSecret        String?  // TOTP secret used to verify 2FA codes (nullable until enabled)
  twoFactorRecoveryCodes String[] @default([]) // Hashed backup recovery codes for 2FA
  emailVerified          Boolean  @default(false) // Whether the email address was verified via the emailed link
  oauthProvider    String?  // OAuth provider used to create/link this account (e.g. "google")
  oauthProviderId  String?  // Unique user ID from the OAuth provider
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  refreshTokens     RefreshToken[]     // Active/past refresh tokens for this user
  connectedAccounts ConnectedAccount[] // Ad platform OAuth connections
  campaigns         UacmCampaign[]     // Campaigns owned by this user

  // Unique constraint: one Google account can only be linked to one UACM user
  @@unique([oauthProvider, oauthProviderId])
}

// Model for storing server-side refresh tokens (hash only, never the raw token)
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    // ID of the user this refresh token belongs to
  tokenHash String    @unique // SHA-256 hash of the refresh token (raw token is never stored)
  expiresAt DateTime  // When the refresh token expires
  revokedAt DateTime? // When the token was revoked/rotated (null = still valid)
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index for faster lookups by user
  @@index([userId])
}

// Enum representing supported advertising platforms
enum Platform {
  META    // Meta Ads (Facebook/Instagram)
  GOOGLE  // Google Ads
  LINKEDIN // LinkedIn Ads
  X       // X (Twitter) Ads
  SNAPCHAT // Snapchat Ads
  TIKTOK  // TikTok Ads
}

// Enum representing the connection lifecycle of an advertising account
enum ConnectedAccountStatus {
  CONNECTED                 // Linked and the access token is valid
  DISCONNECTED              // User disconnected the account (tokens cleared)
  TOKEN_EXPIRED             // Access token expired; refresh not yet attempted
  REAUTHORIZATION_REQUIRED  // Token refresh failed; user must re-connect
}

// Enum representing the status of a campaign
enum CampaignStatus {
  PENDING // Campaign is waiting to be processed
  ACTIVE  // Campaign is active and running
  PAUSED  // Campaign is temporarily paused
  ERROR   // Campaign encountered an error
}

// Model for storing connected OAuth accounts for ad platforms
model ConnectedAccount {
  id                String                 @id @default(cuid())
  userId            String                 // ID of the user who owns this account
  platform          Platform               // The ad platform this account is for
  status            ConnectedAccountStatus @default(CONNECTED) // Connection lifecycle status
  accessToken       String                 // AES-256-GCM encrypted OAuth access token (never plaintext)
  refreshToken      String?                // AES-256-GCM encrypted OAuth refresh token (optional)
  expiresAt         DateTime?              // When the access token expires (optional)
  tenantId          String                 // Tenant that owns this connection
  platformAccountId String?                // Ad account id on the provider side (e.g. Meta ad account / Google customer id)
  lastSyncedAt      DateTime?              // When the platform campaigns were last imported
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique constraint: a user can't have multiple accounts for the same platform
  @@unique([userId, platform])

  // Index for listing a user's connections
  @@index([userId])
}

// Canonical UACM Campaign model - the single source of truth for a campaign
model UacmCampaign {
  id               String           @id @default(cuid())
  userId           String           // ID of the user who owns this campaign
  name             String           // Human-readable name for the campaign
  status           CampaignStatus   @default(PENDING) // Overall campaign status
  budget           Decimal          @db.Decimal(10, 2) // Total budget for the campaign
  startDate        DateTime         // When the campaign should start
  endDate          DateTime         // When the campaign should end
  tenantId         String?          // Tenant that owns this campaign (for multi-tenancy)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platformCampaigns PlatformCampaign[] // Campaign-specific configs for each platform
  metricLogs        MetricLog[]        // Performance metrics for this campaign

  // Indexes
  @@index([userId])
  @@index([tenantId])
}

// Platform-specific campaign configuration
model PlatformCampaign {
  id               String           @id @default(cuid())
  uacmCampaignId   String           // ID of the parent UACM campaign
  platform         Platform         // The ad platform this is for
  platformCampaignId String?        // The campaign ID from the ad platform (e.g., Meta/Google ID)
  platformData     Json             @db.JsonB // Unstructured platform-specific config (JSONB for fast querying)
  status           CampaignStatus   @default(PENDING) // Status of this platform-specific campaign
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  uacmCampaign UacmCampaign @relation(fields: [uacmCampaignId], references: [id], onDelete: Cascade)
  metricLogs   MetricLog[]

  // Unique constraint: one platform campaign per UACM campaign and platform
  @@unique([uacmCampaignId, platform])

  // Index for import lookups by (platform, external platform campaign id)
  @@index([platform, platformCampaignId])
}

// Model for storing campaign performance metrics
model MetricLog {
  id                String           @id @default(cuid())
  uacmCampaignId    String           // ID of the parent UACM campaign
  platformCampaignId String          // ID of the platform campaign
  platform          Platform         // The ad platform this is for
  date              DateTime         // Date/time these metrics are for
  unifiedMetrics    Json             @db.JsonB // Metrics in UACM's unified format
  rawMetrics        Json             @db.JsonB // Raw metrics from the ad platform
  createdAt         DateTime         @default(now())

  // Relations
  uacmCampaign     UacmCampaign     @relation(fields: [uacmCampaignId], references: [id], onDelete: Cascade)
  platformCampaign PlatformCampaign @relation(fields: [platformCampaignId], references: [id], onDelete: Cascade)
}

// Model for idempotency records (prevents duplicate processing of events)
model IdempotencyRecord {
  id         String   @id // Unique idempotency key (e.g., "campaign:123")
  processedAt DateTime @default(now()) // When the key was processed

  // Index for efficient TTL-based cleanup queries
  @@index([processedAt])
}

