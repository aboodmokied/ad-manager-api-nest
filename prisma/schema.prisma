// Prisma schema for the Unified Ad Campaign Manager (UACM)
// This schema defines all models for the backend application

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// Enum representing supported advertising platforms
enum Platform {
  META   // Meta Ads (Facebook/Instagram)
  GOOGLE // Google Ads
}

// Enum representing the status of a campaign
enum CampaignStatus {
  PENDING // Campaign is waiting to be processed
  ACTIVE  // Campaign is active and running
  PAUSED  // Campaign is temporarily paused
  ERROR   // Campaign encountered an error
}

// Enum for LLM providers
enum LLMProvider {
  OPENAI    // OpenAI GPT models
  ANTHROPIC // Anthropic Claude models
  GOOGLE    // Google Gemini models
  OLLAMA    // Local models through Ollama
}

// Enum for recommendation types
enum RecommendationType {
  BUDGET_OPTIMIZATION  // Recommendation about budget changes
  AUDIENCE_IMPROVEMENT // Recommendation about audience targeting
  CREATIVE_TWEAK       // Recommendation about ad creatives
  SCHEDULING_ADJUSTMENT // Recommendation about campaign scheduling
  GENERAL_PERFORMANCE  // General performance improvement
}

// Enum for AI analysis types
enum AnalysisType {
  CAMPAIGN_PERFORMANCE  // Analysis of overall campaign performance
  ANOMALY_DETECTION     // Detection of abnormal behavior
  PERFORMANCE_PREDICTION // Prediction of future performance
}

// Model for storing connected OAuth accounts for ad platforms
model ConnectedAccount {
  id           String    @id @default(cuid())
  userId       String    // ID of the user who owns this account
  platform     Platform  // The ad platform this account is for
  accessToken  String    // OAuth access token for the platform
  refreshToken String?   // OAuth refresh token (optional, depending on platform)
  expiresAt    DateTime? // When the access token expires (optional)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Unique constraint: a user can't have multiple accounts for the same platform
  @@unique([userId, platform])
}

// Canonical UACM Campaign model - the single source of truth for a campaign
model UacmCampaign {
  id               String           @id @default(cuid())
  userId           String           // ID of the user who owns this campaign
  name             String           // Human-readable name for the campaign
  status           CampaignStatus   @default(PENDING) // Overall campaign status
  budget           Decimal          @db.Decimal(10, 2) // Total budget for the campaign
  startDate        DateTime         // When the campaign should start
  endDate          DateTime         // When the campaign should end
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  platformCampaigns PlatformCampaign[] // Campaign-specific configs for each platform
  metricLogs       MetricLog[]         // Performance metrics for this campaign
  recommendations  AIRecommendation[]  // AI-generated recommendations for this campaign
  analyses         AIAnalysis[]        // AI-generated analyses for this campaign
}

// Platform-specific campaign configuration
model PlatformCampaign {
  id               String           @id @default(cuid())
  uacmCampaignId   String           // ID of the parent UACM campaign
  platform         Platform         // The ad platform this is for
  platformCampaignId String?        // The campaign ID from the ad platform (e.g., Meta/Google ID)
  platformData     Json             @db.JsonB // Unstructured platform-specific config (JSONB for fast querying)
  status           CampaignStatus   @default(PENDING) // Status of this platform-specific campaign
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  uacmCampaign UacmCampaign @relation(fields: [uacmCampaignId], references: [id], onDelete: Cascade)
  metricLogs   MetricLog[]

  // Unique constraint: one platform campaign per UACM campaign and platform
  @@unique([uacmCampaignId, platform])
}

// Model for storing campaign performance metrics
model MetricLog {
  id                String           @id @default(cuid())
  uacmCampaignId    String           // ID of the parent UACM campaign
  platformCampaignId String          // ID of the platform campaign
  platform          Platform         // The ad platform this is for
  date              DateTime         // Date/time these metrics are for
  unifiedMetrics    Json             @db.JsonB // Metrics in UACM's unified format
  rawMetrics        Json             @db.JsonB // Raw metrics from the ad platform
  createdAt         DateTime         @default(now())

  // Relations
  uacmCampaign     UacmCampaign     @relation(fields: [uacmCampaignId], references: [id], onDelete: Cascade)
  platformCampaign PlatformCampaign @relation(fields: [platformCampaignId], references: [id], onDelete: Cascade)
}

// Model for idempotency records (prevents duplicate processing of events)
model IdempotencyRecord {
  id         String   @id // Unique idempotency key (e.g., "campaign:123")
  processedAt DateTime @default(now()) // When the key was processed

  // Index for faster lookups
  @@index([id])
}

// ========================================
// AI-RELATED MODELS
// ========================================

// Model for storing AI conversations
model AIConversation {
  id        String       @id @default(cuid())
  userId    String       // ID of the user who owns this conversation
  title     String       // Human-readable title for the conversation
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  messages AIMessage[]
  usage    AIUsage[]
}

// Model for storing individual AI conversation messages
model AIMessage {
  id             String    @id @default(cuid())
  conversationId String    // ID of the parent conversation
  role           String    // "user" | "assistant" | "system"
  content        String    // The message content
  metadata       Json?     @db.JsonB // Additional metadata (token counts, timings, etc.)
  createdAt      DateTime  @default(now())

  // Relations
  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Model for storing AI-generated campaign recommendations
model AIRecommendation {
  id          String             @id @default(cuid())
  campaignId  String             // ID of the campaign this recommendation is for
  type        RecommendationType // Type of recommendation
  description String             // Detailed recommendation text
  priority    String             // Priority level: "low" | "medium" | "high" | "critical"
  confidence  Decimal            @db.Decimal(3, 2) // Confidence score (0.00 - 1.00)
  reason      String             // Reasoning behind the recommendation
  expectedImpact String          // Expected impact of implementing this recommendation
  createdAt   DateTime           @default(now())

  // Relations
  campaign UacmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Model for storing AI campaign analyses
model AIAnalysis {
  id          String       @id @default(cuid())
  campaignId  String       // ID of the campaign this analysis is for
  type        AnalysisType // Type of analysis performed
  insights    Json         @db.JsonB // Structured insights from the analysis
  summary     String       // Human-readable summary
  createdAt   DateTime     @default(now())

  // Relations
  campaign UacmCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

// Model for tracking AI usage (token counts, costs, etc.)
model AIUsage {
  id             String       @id @default(cuid())
  conversationId String?      // ID of the conversation this usage is associated with
  userId         String       // ID of the user who made the request
  provider       LLMProvider  // LLM provider used
  model          String       // Specific model used (e.g., "gpt-4o", "claude-3-opus")
  promptTokens   Int          // Number of tokens in the prompt
  completionTokens Int        // Number of tokens in the completion
  totalTokens    Int          // Total tokens used
  cost           Decimal      @db.Decimal(10, 4) // Estimated cost of this request
  requestType    String       // Type of request: "chat" | "analysis" | "report" | "recommendation"
  createdAt      DateTime     @default(now())

  // Relations
  conversation AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// Model for storing vector embeddings for RAG
model VectorDocument {
  id          String  @id @default(cuid())
  content     String  // Original text content
  metadata    Json?   @db.JsonB // Additional metadata about the document
  embedding   Unsupported("vector(1536)") // Vector embedding (1536-dimensional for OpenAI embeddings)
  createdAt   DateTime @default(now())

  // Index for fast similarity search
  @@index([embedding])
}
